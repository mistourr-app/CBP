{
  "name": "cbp",
  "version": "0.2.0",
  "description": "City Builder — choice-driven text-based city builder PWA",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "node serve.js",
    "start:watch": "node --watch serve.js",
    "serve:start": "node serve-ctl.js start",
    "serve:stop": "node serve-ctl.js stop",
    "serve:status": "node serve-ctl.js status",
    "serve:restart": "node serve-ctl.js restart",
    "test": "node --test",
    "check:boot": "node scripts/check-boot.js"
  },
  "engines": {
    "node": ">=18"
  }
}